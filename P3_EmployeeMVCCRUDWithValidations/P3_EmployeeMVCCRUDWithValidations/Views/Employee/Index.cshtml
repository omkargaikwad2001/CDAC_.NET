@model List<Employee>
<div>
    <a asp-action="AddEmp" asp-controller="Employee" class="btn btn-primary">Add New Emp</a>
   <h3 style="color:green">@ViewBag.Message   </h3>        
    <table class="table table-bordered">
<thead>
<tr><th>ID</th>
    <th>Ename</th>
    <th>Salary</th>
    <th>Address</th>
    <th>Gender</th>
    <th>Edit</th>
    <th>Delete</th>
    </tr>
</thead>
<tbody>
    @foreach (var item in Model)
        {
            <tr><td>@item.Id</td>
                <td>@item.Ename</td>
                <td>@item.Salary</td>
                <td>@item.Address</td>
                <td>@item.Gender</td>
                <td>
                    <a asp-action="EditEmp" asp-controller="Employee" asp-route-id="@item.Id" class="btn btn-secondary" >Edit</a>
                    </td>
                    <td>
                    <a asp-action="DeleteEmp" asp-controller="Employee" asp-route-id="@item.Id" class="btn btn-danger" onclick="return confirm('Do you really want to delete record?')" >Delete</a>
                    </td>
            </tr>
        }
</tbody>
</table>
</div>

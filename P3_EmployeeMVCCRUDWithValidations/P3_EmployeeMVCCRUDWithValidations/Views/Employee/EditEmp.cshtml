@model Employee
<div class="container">
    <form asp-action="EditEmp" asp-controller="Employee" method="post">
    <div>
        <label class="form-label"> Id</label>
        <input type="text" asp-for="Id" class="form-control" readonly="readonly"/>
    </div>
    <div>
        <label class="form-label"> Name</label>
        <input type="text" asp-for="Ename" class="form-control"/>
    </div>
    <div>
        <label class="form-label"> Salary</label>
        <input type="text" asp-for="Salary" class="form-control"/>
    </div>
    <div>
        <label class="form-label"> Address</label>
        <input type="text" asp-for="Address" class="form-control"/>
    </div>
    <div>
        <label class="form-label"> Geneder</label>
        <select asp-for="Gender" class="form-control">
            <option value=""> Select</option>
            <option value="Male"> Male</option>
            <option value="Female"> Female</option>
        </select>
    </div>
    <div>
        <input type="submit" value="Update" class="btn btn-primary"/>
       <input type="reset" value="Reset" class="btn btn-warning"/>
    </div>
    </form>
</div>
